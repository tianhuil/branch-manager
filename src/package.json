{
  "name": "@db-branch/core",
  "version": "1.0.0",
  "description": "Database branch manager for PostgreSQL - lightweight alternative to vendor-specific branching",
  "type": "module",
  "bin": {
    "bm": "./index.ts"
  },
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./db": "./db.ts",
    "./preview": "./preview.ts",
    "./logger": "./logger.ts",
    "./util": "./util.ts"
  },
  "scripts": {
    "test": "bun test",
    "test:e2e": "bun test ./**/*.e2e.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "keywords": [
    "database",
    "postgresql",
    "postgres",
    "branch",
    "preview",
    "ci",
    "cd",
    "vercel"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "commander": "^14.0.1",
    "pino": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "bun-types": "^1.2.0",
    "pino-pretty": "^13.1.1",
    "typescript": "^5"
  }
}
