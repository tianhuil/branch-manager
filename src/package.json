{
  "name": "@tianhuil/branch-manager",
  "version": "1.2.0",
  "description": "Database branch manager for PostgreSQL - lightweight alternative to vendor-specific branching",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "bm": "index.ts"
  },
  "main": "index.ts",
  "types": "index.ts",
  "exports": {
    ".": {
      "types": "index.ts",
      "default": "index.ts"
    },
    "./db": {
      "types": "db.ts",
      "default": "db.ts"
    },
    "./preview": {
      "types": "preview.ts",
      "default": "preview.ts"
    },
    "./logger": {
      "types": "logger.ts",
      "default": "logger.ts"
    },
    "./util": {
      "types": "util.ts",
      "default": "util.ts"
    }
  },
  "files": [
    "../dist",
    "README.md"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "tsup && chmod +x ../dist/index.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "check": "eslint && prettier --check . && tsc --noEmit",
    "check:fix": "eslint --fix && prettier --write ."
  },
  "keywords": [
    "database",
    "postgresql",
    "postgres",
    "branch",
    "preview",
    "ci",
    "cd",
    "vercel"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "commander": "^14.0.1",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/prompts": "^2.4.9",
    "bun-types": "^1.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5"
  }
}
