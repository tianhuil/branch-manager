# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# but allow dotenvx keys, encrypted env files, and example file
!.env.staging
!.env.production
!.env.development
!.env.ci
!.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

scrach

pack/
