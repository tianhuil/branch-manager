{
  "name": "branch-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "bm": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "default": "./dist/db.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "default": "./dist/logger.js"
    },
    "./util": {
      "types": "./dist/util.d.ts",
      "default": "./dist/util.js"
    }
  },
  "files": [
    "dist",
    "src/README.md"
  ],
  "workspaces": [
    "src",
    "web"
  ],
  "scripts": {
    "dev": "bun --cwd web dev",
    "build": "bun --cwd web build && bun --cwd src build",
    "start": "bun --cwd web start",
    "prepare": "bun --cwd src build",
    "pack": "bun pm pack --destination pack/",
    "test": "dotenvx run -f .env.ci -- bun test",
    "test:unit": "bun test $(find src -name '*.test.ts' ! -name '*.e2e.test.ts')",
    "test:e2e": "dotenvx run -f .env.ci -- bun test $(find src -name '*.e2e.test.ts')",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:workspaces": "bun --cwd src lint && bun --cwd web lint",
    "lint:workspaces:fix": "bun --cwd src lint:fix && bun --cwd web lint:fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "bun --cwd src typecheck && bun --cwd web typecheck",
    "spell": "cspell \"**/*\"",
    "spell:fix": "cspell \"**/*\" --no-progress --no-summary",
    "check": "bun run lint && bun run format && bun run typecheck && bun run spell",
    "check:fix": "bun run lint:fix && bun run format:fix && bun run spell:fix",
    "bm": "bun --cwd src index.ts",
    "db:create": "dotenvx run -f .env.${VERCEL_ENV} -f .env -f .env.ci -- bun run bm db create"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "commander": "^14.0.1",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.1"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.51.0",
    "@eslint/js": "^9.37.0",
    "@types/node": "^24",
    "bun-types": "^1.3.0",
    "cspell": "^9.2.1",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "typescript-eslint": "^8.46.0",
    "vercel": "^48.2.8"
  }
}
