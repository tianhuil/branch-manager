{
  "name": "@neon-prototype/db-branch",
  "version": "1.0.0",
  "type": "module",
  "description": "Database branch manager for PostgreSQL - create isolated preview databases for Git branches",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "db-branch": "./dist/index.js",
    "bm": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "default": "./dist/db.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "default": "./dist/logger.js"
    },
    "./util": {
      "types": "./dist/util.d.ts",
      "default": "./dist/util.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "test:e2e": "dotenvx run -f .env.root.local -f .env -- bun test ./script/**/*.e2e.ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "spell": "cspell \"**/*\"",
    "spell:fix": "cspell \"**/*\" --no-progress --no-summary",
    "check": "eslint && prettier . && tsc --noEmit && cspell \"**/*\"",
    "check:fix": "eslint --fix && prettier --write . && cspell \"**/*\" --no-progress --no-summary",
    "web:dev": "cd web && dotenvx run -f .env.development -f .env -- next dev --turbopack",
    "web:build": "cd web && dotenvx run -f .env.$VERCEL_ENV -f .env -- next build --turbopack",
    "web:start": "cd web && dotenvx run -f .env.$VERCEL_ENV -f .env -- next start"
  },
  "keywords": [
    "database",
    "postgresql",
    "postgres",
    "branch",
    "preview",
    "git",
    "ci-cd",
    "neon",
    "drizzle",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/db-branch"
  },
  "bugs": {
    "url": "https://github.com/yourusername/db-branch/issues"
  },
  "homepage": "https://github.com/yourusername/db-branch#readme",
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "commander": "^14.0.1",
    "pino": "^10.0.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.51.0",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.0",
    "cspell": "^9.2.1",
    "drizzle-kit": "^0.31.5",
    "drizzle-orm": "^0.44.6",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "eslint-plugin-boundaries": "^5.0.2",
    "next": "15.5.4",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "^48.2.8"
  },
  "peerDependencies": {
    "@neondatabase/serverless": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  }
}
