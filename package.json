{
  "name": "neon-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "bm": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "default": "./dist/db.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "default": "./dist/logger.js"
    },
    "./util": {
      "types": "./dist/util.d.ts",
      "default": "./dist/util.js"
    }
  },
  "files": [
    "dist",
    "src/README.md"
  ],
  "workspaces": [
    "src",
    "web"
  ],
  "scripts": {
    "dev": "cd web && bun run dev",
    "build": "(cd src && bun run build) && (cd web && bun run build)",
    "build:src": "cd src && bun run build",
    "build:web": "cd web && bun run build",
    "start": "cd web && bun run start",
    "prepare": "cd src && bun run build",
    "pack": "bun pm pack --destination dist/",
    "test": "bun test",
    "test:e2e": "dotenvx run -f .env.root.local -f .env -- bun test ./src/**/*.e2e.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:workspaces": "(cd src && bun run lint) && (cd web && bun run lint)",
    "lint:workspaces:fix": "(cd src && bun run lint:fix) && (cd web && bun run lint:fix)",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "(cd src && bun run typecheck) && (cd web && bun run typecheck)",
    "spell": "cspell \"**/*\"",
    "spell:fix": "cspell \"**/*\" --no-progress --no-summary",
    "check": "bun run lint && bun run format && bun run typecheck && bun run spell",
    "check:fix": "bun run lint:fix && bun run format:fix && bun run spell:fix",
    "bm": "cd src && bun run index.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "commander": "^14.0.1",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.1"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.51.0",
    "@eslint/js": "^9.37.0",
    "@types/node": "^20",
    "bun-types": "^1.3.0",
    "cspell": "^9.2.1",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "typescript": "^5",
    "typescript-eslint": "^8.46.0",
    "vercel": "^48.2.8"
  }
}
